RewriteEngine On
# Canonicalize the public host only; staging and local keep their own URLs.
RewriteCond %{HTTP_HOST} ^(www\.)?baralaye\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.baralaye\.com$ [NC]
RewriteRule ^ https://baralaye.com%{REQUEST_URI} [R=301,L]
RedirectMatch ^/(.*)/$ /$1
RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]
RewriteRule ^.*$ index.php [NC,L]
<IfModule mod_php5.c>
php_flag magic_quotes_gpc Off
</IfModule>

# Keep staging, local, and other non-production hosts out of search results,
# including static files. PHP also sends this header for dynamic pages.
<IfModule mod_headers.c>
SetEnvIfNoCase Host "^(?!((www\.)?baralaye\.com)$).+" seo_noindex
Header always set X-Robots-Tag "noindex, follow" env=seo_noindex
</IfModule>
